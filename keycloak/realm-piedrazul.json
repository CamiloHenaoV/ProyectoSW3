{
  "realm": "piedrazul",
  "displayName": "Piedrazul · Citas médicas",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(8) and digits(1) and notUsername",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "en"
  ],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "Paciente",
        "description": "Paciente del centro: agenda y consulta sus propias citas"
      },
      {
        "name": "Agendador",
        "description": "Agendador de citas: consulta agendas, exporta e historial por cédula"
      },
      {
        "name": "Administrador",
        "description": "Administrador: configura la disponibilidad de los profesionales"
      },
      {
        "name": "Medico",
        "description": "Médico: consulta y exporta su agenda, consulta historial por cédula"
      },
      {
        "name": "Terapista",
        "description": "Terapista: consulta y exporta su agenda, consulta historial por cédula"
      },
      {
        "name": "default-roles-piedrazul",
        "description": "Roles por defecto",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-piedrazul"
  },
  "clients": [
    {
      "clientId": "piedrazul-frontend",
      "name": "SPA Angular de Piedrazul",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "piedrazul-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "medico_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "medico_id",
            "claim.name": "medico_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "documento",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "documento",
            "claim.name": "documento",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "piedrazul-api",
      "name": "API ASP.NET Core de Piedrazul",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "cambiar-este-secreto-en-desarrollo",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
